    <org.eventb.core.event name="element3" org.eventb.core.comment="EQU3, EQU4,treat both types of buttons the same" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="Order">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Order"/>
