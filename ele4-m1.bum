        <org.eventb.core.guard name=")" org.eventb.core.label="grd5" org.eventb.core.predicate="∃x·(x∈orders ∧ x&lt;floor)"/>
        <org.eventb.core.guard name="grd1" org.eventb.core.label="grd6" org.eventb.core.predicate="next_dest=max({x∣x∈orders ∧ x&lt;floor})"/>
