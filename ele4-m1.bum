<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd" version="5">
    <org.eventb.core.refinesMachine name="'" org.eventb.core.target="ele4-m0"/>
    <org.eventb.core.variable name="var1" org.eventb.core.identifier="floor"/>
    <org.eventb.core.variable name="var2" org.eventb.core.comment="EQU5 (the elevator has doors), FUN7 (controller can open doors)" org.eventb.core.identifier="door"/>
    <org.eventb.core.variable name="var3" org.eventb.core.comment="FUN12 (button status can be seen by controller)" org.eventb.core.identifier="orders"/>
    <org.eventb.core.variable name="var4" org.eventb.core.comment="the floor the elevator should go to. The elevator is moving as soon as /=NONE" org.eventb.core.identifier="destination"/>
    <org.eventb.core.variable name="var5" org.eventb.core.identifier="movement"/>
    <org.eventb.core.variable name="var6" org.eventb.core.identifier="floor_event"/>
    <org.eventb.core.event name="element2" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="INITIALISATION">
        <org.eventb.core.action name="'" org.eventb.core.assignment="direction≔UP" org.eventb.core.label="act2"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element3" org.eventb.core.comment="EQU3, EQU4,treat both types of buttons the same" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="Order">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Order"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element4" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="EnvMove">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="EnvMove"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd6" org.eventb.core.predicate="(direction=UP⇒new_floor−floor=1) ∧ (direction=DOWN⇒new_floor−floor=−1)"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element5" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="ReachOrder">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="ReachOrder"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element6" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="ReachNotOrder">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="ReachNotOrder"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element7" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="EnvStopMoving">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="EnvStopMoving"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element8" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="OpenDoor">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="OpenDoor"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element9" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="CloseDoor">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="CloseDoor"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element:" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="ChooseNextUp">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="ChooseNext"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd1" org.eventb.core.predicate="door=CLOSED ∧ desired_door=CLOSED"/>
        <org.eventb.core.guard name=")" org.eventb.core.comment="sanity to not overwrite existing destination" org.eventb.core.label="grd2" org.eventb.core.predicate="destination=NONE"/>
        <org.eventb.core.action name="+" org.eventb.core.assignment="destination≔min({x∣x∈orders ∧ x&gt;floor})" org.eventb.core.label="act1"/>
        <org.eventb.core.guard name="grd1" org.eventb.core.label="grd4" org.eventb.core.predicate="direction=UP"/>
        <org.eventb.core.guard name="grd2" org.eventb.core.label="grd5" org.eventb.core.predicate="∃x·x∈orders ∧ x&gt;floor"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="evt2" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="ChangeDirectionDown">
        <org.eventb.core.guard name="(" org.eventb.core.label="grd1" org.eventb.core.predicate="desired_door=CLOSED ∧ door=CLOSED"/>
        <org.eventb.core.guard name=")" org.eventb.core.comment="sanity to not overwrite existing destination" org.eventb.core.label="grd2" org.eventb.core.predicate="destination=NONE"/>
        <org.eventb.core.action name="+" org.eventb.core.assignment="direction≔DOWN" org.eventb.core.label="act1"/>
        <org.eventb.core.guard name="grd1" org.eventb.core.label="grd4" org.eventb.core.predicate="direction=UP"/>
        <org.eventb.core.guard name="grd2" org.eventb.core.label="grd5" org.eventb.core.predicate="¬ (∃x·x∈orders ∧ x&gt;floor)"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="evt1" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="ChooseNextDown">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="ChooseNext"/>
        <org.eventb.core.action name="+" org.eventb.core.assignment="destination≔max({x∣x∈orders ∧ x&lt;floor})" org.eventb.core.label="act1"/>
        <org.eventb.core.guard name="internal1" org.eventb.core.label="grd1" org.eventb.core.predicate="door=CLOSED ∧ desired_door=CLOSED"/>
        <org.eventb.core.guard name="internal2" org.eventb.core.comment="sanity to not overwrite existing destination" org.eventb.core.label="grd2" org.eventb.core.predicate="destination=NONE"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd4" org.eventb.core.predicate="direction=DOWN"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd5" org.eventb.core.predicate="∃x·x∈orders ∧ x&lt;floor"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="evt3" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="ChangeDirectionUp">
        <org.eventb.core.guard name="(" org.eventb.core.label="grd1" org.eventb.core.predicate="desired_door=CLOSED ∧ door=CLOSED"/>
        <org.eventb.core.guard name=")" org.eventb.core.comment="sanity to not overwrite existing destination" org.eventb.core.label="grd2" org.eventb.core.predicate="destination=NONE"/>
        <org.eventb.core.action name="+" org.eventb.core.assignment="direction≔UP" org.eventb.core.label="act1"/>
        <org.eventb.core.guard name="grd1" org.eventb.core.label="grd4" org.eventb.core.predicate="direction=DOWN"/>
        <org.eventb.core.guard name="grd2" org.eventb.core.label="grd5" org.eventb.core.predicate="¬ (∃x·x∈orders ∧ x&lt;floor)"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element;" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="EnvDoorOpened">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="EnvDoorOpened"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element=" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="EnvDoorClosed">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="EnvDoorClosed"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="element&gt;" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="EnvStartMoving">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="EnvStartMoving"/>
    </org.eventb.core.event>
    <org.eventb.core.variable name="elementA" org.eventb.core.identifier="desired_door"/>
    <org.eventb.core.variable name="element?" org.eventb.core.identifier="direction"/>
    <org.eventb.core.invariant name="element@" org.eventb.core.label="inv_direction_type" org.eventb.core.predicate="direction∈DIRECTION"/>
    <org.eventb.core.seesContext name="elementB" org.eventb.core.target="ele4-c0"/>
    <org.eventb.core.invariant name="elementC" org.eventb.core.label="inv_can_choose_next" org.eventb.core.predicate="(desired_door=CLOSED ∧ door=CLOSED ∧ destination=NONE ∧ orders≠∅)⇒(&#10;&#9;(desired_door=CLOSED ∧ door=CLOSED ∧ direction=UP ∧ ∃x·x∈orders ∧ x&gt;floor) ∨&#10;&#9;(desired_door=CLOSED ∧ door=CLOSED ∧ destination=NONE ∧ direction=UP ∧ ¬ (∃x·x∈orders ∧ x&gt;floor)) ∨&#10;&#9;(desired_door=CLOSED ∧ door=CLOSED ∧ direction=DOWN ∧ ∃x·x∈orders ∧ x&lt;floor) ∨&#10;&#9;(desired_door=CLOSED ∧ door=CLOSED ∧ destination=NONE ∧ direction=DOWN ∧ ¬ (∃x·x∈orders ∧ x&lt;floor))&#10;)" org.eventb.core.theorem="true"/>
</org.eventb.core.machineFile>
