    <org.eventb.core.event name="element:" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="Choose_Next_UP">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Choose_Next"/>
        <org.eventb.core.guard name="grd1" org.eventb.core.label="grd4" org.eventb.core.predicate="direction=UP"/>
        <org.eventb.core.guard name="grd2" org.eventb.core.label="grd5" org.eventb.core.predicate="∃x·x∈orders ∧ x&gt;floor"/>
        <org.eventb.core.guard name="grd3" org.eventb.core.label="grd6" org.eventb.core.predicate="next_dest=min({x∣x∈orders ∧ x&gt;floor})"/>
