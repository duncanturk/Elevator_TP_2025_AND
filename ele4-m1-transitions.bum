    <org.eventb.core.invariant name="elementS" org.eventb.core.label="inv_state_type" org.eventb.core.predicate="state∈0‥9"/>
    <org.eventb.core.invariant name="elementT" org.eventb.core.label="inv0" org.eventb.core.predicate="state=0 ∧ orders≠∅ ⇔ (door=OPEN ∧ desired_door=OPEN ∧ orders≠∅ ∧ destination=NONE)"/>
    <org.eventb.core.invariant name="elementU" org.eventb.core.label="inv0·1" org.eventb.core.predicate="state=0 ⇔ (door=OPEN ∧ desired_door=OPEN ∧ destination=NONE)"/>
    <org.eventb.core.invariant name="elementV" org.eventb.core.label="inv1" org.eventb.core.predicate="state=1 ⇔ (desired_door=CLOSED ∧ door=OPEN)"/>
    <org.eventb.core.invariant name="elementW" org.eventb.core.label="inv2" org.eventb.core.predicate="state=2 ⇔ (&#10;&#9;(door=CLOSED ∧ desired_door=CLOSED ∧ destination=NONE ∧ direction=DOWN ∧ ¬ (∃x·x∈orders ∧ x&lt;floor)) ∨&#10;&#9;(door=CLOSED ∧ desired_door=CLOSED ∧ destination=NONE ∧ direction=UP ∧ ¬ (∃x·x∈orders ∧ x&gt;floor)) ∨&#10;&#9;(door=CLOSED ∧ desired_door=CLOSED ∧ destination=NONE ∧ direction=UP ∧ ∃x·x∈orders ∧ x&gt;floor) ∨&#10;&#9;(door=CLOSED ∧ desired_door=CLOSED ∧ destination=NONE ∧ direction=DOWN ∧ ∃x·x∈orders ∧ x&lt;floor)&#10;)"/>
    <org.eventb.core.invariant name="elementZ" org.eventb.core.label="inv3" org.eventb.core.predicate="state=3 ⇔ (&#10;&#9;(door=CLOSED ∧ desired_door=CLOSED ∧ destination=NONE ∧ direction=UP ∧ ∃x·x∈orders ∧ x&gt;floor) ∨&#10;&#9;(door=CLOSED ∧ desired_door=CLOSED ∧ destination=NONE ∧ direction=DOWN ∧ ∃x·x∈orders ∧ x&lt;floor)&#10;)"/>
    <org.eventb.core.invariant name="elementa" org.eventb.core.label="inv3·1" org.eventb.core.predicate="state∈2‥3 ⇒ (door=CLOSED ∧ desired_door=CLOSED ∧ destination=NONE)"/>
    <org.eventb.core.invariant name="elementb" org.eventb.core.label="inv3·2" org.eventb.core.predicate="state∈0‥3∪{9} ⇔ (destination=NONE)"/>
    <org.eventb.core.invariant name="elementc" org.eventb.core.label="inv3·3" org.eventb.core.predicate="state∈1‥8 ⇔ (desired_door=CLOSED)"/>
    <org.eventb.core.invariant name="elementd" org.eventb.core.label="inv3·4" org.eventb.core.predicate="state∈1‥5 ⇒ (∃f·f∈orders ∧ f≠floor)"/>
    <org.eventb.core.invariant name="elemente" org.eventb.core.label="inv3·5" org.eventb.core.predicate="state∈1‥8 ⇒ (orders≠∅)"/>
    <org.eventb.core.invariant name="elementf" org.eventb.core.label="inv3·6" org.eventb.core.predicate="(state=0 ∨ state=9) ⇒ (floor∉orders)"/>
    <org.eventb.core.invariant name="element[" org.eventb.core.label="inv4" org.eventb.core.predicate="state=4 ⇔ (destination≠floor ∧ destination≠NONE ∧ movement=STOPPED)"/>
    <org.eventb.core.invariant name="element\" org.eventb.core.label="inv5" org.eventb.core.predicate="state=5 ⇔ (&#10;&#9;floor_event=HANDLED ∧&#10;&#9;movement=MOVING ∧&#10;&#9;(∃new_floor·&#10;&#9;&#9;new_floor∈FLOOR ∧&#10;&#9;&#9;((destination&gt;floor ⇒ new_floor=floor+1) ∧ (destination&lt;floor ⇒ new_floor=floor−1) ∧ destination≠floor) ∧&#10;&#9;&#9;((direction=UP⇒new_floor−floor=1) ∧ (direction=DOWN⇒new_floor−floor=−1))&#10;&#9;)&#10;)"/>
    <org.eventb.core.invariant name="element]" org.eventb.core.label="inv6" org.eventb.core.predicate="state=6 ⇔ (&#10;&#9;(floor∉orders ∧ floor_event=PENDING) ∨&#10;&#9;(floor∈orders ∧ floor_event=PENDING)&#10;)"/>
    <org.eventb.core.invariant name="element^" org.eventb.core.label="inv7" org.eventb.core.predicate="state=7 ⇔ (floor_event=HANDLED ∧ movement=MOVING ∧ floor=destination)"/>
    <org.eventb.core.invariant name="element_" org.eventb.core.label="inv8" org.eventb.core.predicate="state=8 ⇔ (movement=STOPPED ∧ floor=destination)"/>
    <org.eventb.core.invariant name="element`" org.eventb.core.label="inv9" org.eventb.core.predicate="state=9 ⇔ (desired_door=OPEN ∧ door=CLOSED)"/>
    <org.eventb.core.invariant name="elementg" org.eventb.core.label="inv_door" org.eventb.core.predicate="state∈0‥1 ⇔ door=CLOSED"/>
