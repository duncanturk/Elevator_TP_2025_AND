    <org.eventb.core.event name="elementK" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="ChooseNextUp">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="ChooseNextUp"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="elementL" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="ChangeDirectionDown">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="ChangeDirectionDown"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="elementM" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="ChooseNextDown">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="ChooseNextDown"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="elementN" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="ChangeDirectionUp">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="ChangeDirectionUp"/>
