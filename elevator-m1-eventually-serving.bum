    <org.eventb.core.variable name="elementR" org.eventb.core.identifier="waiting_since"/>
    <org.eventb.core.invariant name="elementS" org.eventb.core.label="waiting_type" org.eventb.core.predicate="waiting_since∈FLOOR→ℕ"/>
    <org.eventb.core.invariant name="elementT" org.eventb.core.label="waiting_limit" org.eventb.core.predicate="∀x·x∈FLOOR⇒waiting_since(x)&lt;N_Levels∗2"/>
</org.eventb.core.machineFile>
