<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd" version="5">
    <org.eventb.core.refinesMachine name="'" org.eventb.core.target="elevator-m1"/>
    <org.eventb.core.seesContext name="elementB" org.eventb.core.target="elevator-c0-eventually-serving"/>
    <org.eventb.core.variable name="var1" org.eventb.core.identifier="floor"/>
    <org.eventb.core.variable name="var2" org.eventb.core.comment="EQU5 (the elevator has doors), FUN7 (controller can open doors)" org.eventb.core.identifier="door"/>
    <org.eventb.core.variable name="var3" org.eventb.core.comment="FUN12 (button status can be seen by controller)" org.eventb.core.identifier="orders"/>
    <org.eventb.core.variable name="var4" org.eventb.core.comment="the floor the elevator should go to. The elevator is moving as soon as /=NONE" org.eventb.core.identifier="destination"/>
    <org.eventb.core.variable name="var5" org.eventb.core.identifier="movement"/>
    <org.eventb.core.variable name="var6" org.eventb.core.identifier="floor_event"/>
    <org.eventb.core.variable name="elementA" org.eventb.core.identifier="desired_door"/>
    <org.eventb.core.variable name="element?" org.eventb.core.identifier="direction"/>
    <org.eventb.core.event name="elementC" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="INITIALISATION">
        <org.eventb.core.action name="'" org.eventb.core.assignment="waiting_since≔FLOOR×{0}" org.eventb.core.label="act3"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="elementD" org.eventb.core.comment="EQU3, EQU4,treat both types of buttons the same" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="Order">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Order"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="elementE" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="EnvMove">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="EnvMove"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="elementF" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="ReachOrder">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="ReachOrder"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="elementG" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="ReachNotOrder">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="ReachNotOrder"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="elementH" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="EnvStopMoving">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="EnvStopMoving"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="elementI" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="OpenDoor">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="OpenDoor"/>
        <org.eventb.core.action name="act1" org.eventb.core.assignment="waiting_since≔((waiting_since;add_one){floor↦0})((FLOOR∖orders)×{0})" org.eventb.core.label="act_inc_and_reset"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="elementJ" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="CloseDoor">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="CloseDoor"/>
