    <org.eventb.core.invariant name="elementB" org.eventb.core.label="inv_state_type" org.eventb.core.predicate="state∈ℕ"/>
    <org.eventb.core.invariant name="elementC" org.eventb.core.label="inv0" org.eventb.core.predicate="state=0 ∧ orders≠∅ ⇔ (door=OPEN ∧ desired_door=OPEN ∧ orders≠∅ ∧ destination=NONE)"/>
    <org.eventb.core.invariant name="elementM" org.eventb.core.label="inv0·1" org.eventb.core.predicate="state=0 ⇔ (door=OPEN ∧ desired_door=OPEN ∧ destination=NONE)"/>
    <org.eventb.core.invariant name="elementE" org.eventb.core.label="inv1" org.eventb.core.predicate="state=1 ⇔ (desired_door=CLOSED ∧ door=OPEN)"/>
    <org.eventb.core.invariant name="elementF" org.eventb.core.label="inv2" org.eventb.core.predicate="state=2 ⇔ (door=CLOSED ∧ desired_door=CLOSED ∧ destination=NONE ∧ orders≠∅)"/>
    <org.eventb.core.invariant name="elementG" org.eventb.core.label="inv3" org.eventb.core.predicate="state=3 ⇔ (destination≠floor ∧ destination≠NONE ∧ movement=STOPPED)"/>
    <org.eventb.core.invariant name="elementH" org.eventb.core.label="inv4" org.eventb.core.predicate="state=4 ⇔ (floor_event=HANDLED ∧ movement=MOVING ∧ (∃new_floor·new_floor∈FLOOR ∧ (destination&gt;floor ⇒ new_floor=floor+1) ∧ (destination&lt;floor ⇒ new_floor=floor−1)) ∧ destination≠floor)"/>
    <org.eventb.core.invariant name="elementI" org.eventb.core.label="inv5" org.eventb.core.predicate="state=5 ⇔ (&#10;&#9;(floor∉orders ∧ floor_event=PENDING) ∨&#10;&#9;(floor∈orders ∧ floor_event=PENDING)&#10;)"/>
    <org.eventb.core.invariant name="elementJ" org.eventb.core.label="inv6" org.eventb.core.predicate="state=6 ⇒ (floor_event=HANDLED ∧ movement=MOVING ∧ floor=destination)"/>
    <org.eventb.core.invariant name="elementO" org.eventb.core.label="inv7" org.eventb.core.predicate="state=7 ⇔ (movement=STOPPED ∧ floor=destination)"/>
    <org.eventb.core.invariant name="elementP" org.eventb.core.label="inv8" org.eventb.core.predicate="state=8 ⇔ (desired_door=OPEN ∧ door=CLOSED)"/>
