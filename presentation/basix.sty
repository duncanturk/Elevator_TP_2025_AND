\newcommand{\ceil}[1]{{\left\lceil #1 \right\rceil}}
\newcommand{\floor}[1]{{\left\lfloor #1 \right\rfloor}}
\newcommand{\abs}[1]{{\left| #1 \right|}}

\definecolor{mygreen}{HTML}{2F8E34}
\definecolor{myblue}{HTML}{1A1A83}

\newcommand{\Constant}[1]{\texttt{#1}}
\newcommand{\Variable}[1]{\texttt{#1}}
\newcommand{\Requirement}[1]{\textcolor{red}{\texttt{\MakeUppercase{#1}}}}
\newcommand{\Event}[1]{\textcolor{mygreen}{\texttt{\textbf{#1}}}}
\newcommand{\Invariant}[1]{\textcolor{mygreen}{\texttt{#1}}}
\newcommand{\InvariantName}[1]{\textcolor{myblue}{\texttt{#1}}}
\newcommand{\Guard}[1]{\textcolor{mygreen}{\texttt{#1}}}
\newcommand{\Action}[1]{\textcolor{mygreen}{\texttt{#1}}}
\newcommand{\ActionName}[1]{\textcolor{myblue}{\texttt{#1}}}

\newcommand{\Req}[2]{
	\begin{tabularx}{\linewidth}{|l|X|}\hline
	\Requirement{#1} & #2\\\hline
	\end{tabularx}
}
\newcommand{\Inv}[2]{\InvariantName{#1:}\Invariant{#2}}
\newcommand{\Act}[2]{\ActionName{#1:}\Action{#2}}
\newcommand{\InvThm}[2]{\InvariantName{#1}\textcolor{gray}{$^\texttt{THM}$:}\Invariant{#2}}

\newcommand{\eventBOverride}{
