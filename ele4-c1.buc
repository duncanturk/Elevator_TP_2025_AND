<org.eventb.core.contextFile org.eventb.core.configuration="org.eventb.core.fwd;de.prob.symbolic.ctxBase" version="3">
    <org.eventb.core.extendsContext name="'" org.eventb.core.target="ele4-c0"/>
    <org.eventb.core.constant name="cst1" org.eventb.core.identifier="cut"/>
    <org.eventb.core.axiom name="axm1" org.eventb.core.label="axm_cut" org.eventb.core.predicate="cut∈(FLOOR×ℙ(FLOOR)×DIRECTION)→ℙ(FLOOR)"/>
    <org.eventb.core.axiom name="axm2" org.eventb.core.label="axm_cut_up" org.eventb.core.predicate="∀floor,orders,direction·floor∈FLOOR∧orders⊆FLOOR∧direction∈DIRECTION&#10;∧ direction=UP&#10;⇒cut(floor↦orders↦direction)={x∣x∈orders∧x&gt;floor}"/>
    <org.eventb.core.axiom name="axm3" org.eventb.core.label="axm_cut_down" org.eventb.core.predicate="∀floor,orders,direction·floor∈FLOOR∧orders⊆FLOOR∧direction∈DIRECTION&#10;∧ direction=DOWN&#10;⇒cut(floor↦orders↦direction)={x∣x∈orders∧x&lt;floor}"/>
</org.eventb.core.contextFile>
