<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<org.eventb.core.machineFile org.eventb.core.configuration="org.eventb.core.fwd" version="5">
    <org.eventb.core.refinesMachine name="'" org.eventb.core.target="ele2-m0"/>
    <org.eventb.core.seesContext name="," org.eventb.core.target="ele2-c1"/>
    <org.eventb.core.variable name="(" org.eventb.core.identifier="floor"/>
    <org.eventb.core.variable name="*" org.eventb.core.identifier="door"/>
    <org.eventb.core.variable name="+" org.eventb.core.identifier="orders"/>
    <org.eventb.core.variable name="." org.eventb.core.identifier="destination"/>
    <org.eventb.core.event name="/" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="INITIALISATION">
        <org.eventb.core.action name="'" org.eventb.core.assignment="floor, door,orders≔1, OPEN,∅" org.eventb.core.label="act1"/>
        <org.eventb.core.action name="(" org.eventb.core.assignment="destination≔NONE" org.eventb.core.label="act2"/>
        <org.eventb.core.action name=")" org.eventb.core.assignment="direction≔UP" org.eventb.core.label="act3"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="0" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="Arrive">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Arrive"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="1" org.eventb.core.convergence="0" org.eventb.core.extended="true" org.eventb.core.label="E_Move">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="E_Move"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="2" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="Next_UP">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Next"/>
        <org.eventb.core.guard name="," org.eventb.core.label="grd3" org.eventb.core.predicate="direction=UP"/>
        <org.eventb.core.guard name="'" org.eventb.core.label="grd1" org.eventb.core.predicate="cut(floor↦ orders↦ direction)≠∅"/>
        <org.eventb.core.guard name="/" org.eventb.core.label="grd5" org.eventb.core.predicate="dest=min(cut(floor↦ orders↦ direction))"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd2" org.eventb.core.predicate="door=OPEN"/>
        <org.eventb.core.action name="*" org.eventb.core.assignment="door≔CLOSED" org.eventb.core.label="act1"/>
        <org.eventb.core.action name="+" org.eventb.core.assignment="destination≔min(cut(floor↦ orders↦ direction))" org.eventb.core.label="act2"/>
        <org.eventb.core.guard name="-" org.eventb.core.label="grd4" org.eventb.core.predicate="destination=NONE" org.eventb.core.theorem="true"/>
        <org.eventb.core.parameter name="." org.eventb.core.identifier="dest"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="evt1" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="Next_DOWN">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Next"/>
        <org.eventb.core.guard name="'" org.eventb.core.label="grd1" org.eventb.core.predicate="{x∣x∈orders ∧ x&lt;floor}≠∅"/>
        <org.eventb.core.guard name=")" org.eventb.core.label="grd2" org.eventb.core.predicate="door=OPEN"/>
        <org.eventb.core.action name="*" org.eventb.core.assignment="door≔CLOSED" org.eventb.core.label="act1"/>
        <org.eventb.core.action name="+" org.eventb.core.assignment="destination≔max({x∣x∈orders∧x&lt;floor})" org.eventb.core.label="act2"/>
        <org.eventb.core.guard name="/" org.eventb.core.label="grd5" org.eventb.core.predicate="dest=max({x∣x∈orders∧x&lt;floor})"/>
        <org.eventb.core.guard name="," org.eventb.core.label="grd3" org.eventb.core.predicate="direction=DOWN"/>
        <org.eventb.core.guard name="-" org.eventb.core.label="grd4" org.eventb.core.predicate="destination=NONE" org.eventb.core.theorem="true"/>
        <org.eventb.core.parameter name="." org.eventb.core.identifier="dest"/>
    </org.eventb.core.event>
    <org.eventb.core.event name="3" org.eventb.core.convergence="0" org.eventb.core.extended="false" org.eventb.core.label="Order">
        <org.eventb.core.refinesEvent name="'" org.eventb.core.target="Order"/>
        <org.eventb.core.parameter name="'" org.eventb.core.identifier="order"/>
        <org.eventb.core.guard name="(" org.eventb.core.label="grd1" org.eventb.core.predicate="order∈(FLOOR∖orders)∖{floor}"/>
        <org.eventb.core.action name=")" org.eventb.core.assignment="orders≔orders ∪ {order}" org.eventb.core.label="act1"/>
    </org.eventb.core.event>
    <org.eventb.core.variable name="4" org.eventb.core.identifier="direction"/>
    <org.eventb.core.invariant name="5" org.eventb.core.label="inv_types" org.eventb.core.predicate="direction∈DIRECTION"/>
    <org.eventb.core.invariant name="evt2" org.eventb.core.comment="&#10;In Next_UP and Next_DOWN &#10;we dont have to look for the current floor,&#10;since it is never a order" org.eventb.core.label="inv1" org.eventb.core.predicate="door=OPEN⇒floor∉orders"/>
</org.eventb.core.machineFile>
